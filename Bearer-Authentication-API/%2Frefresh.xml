<?xml version="1.0" encoding="UTF-8"?>
<con:resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:con="http://eviware.com/soapui/config" name="/refresh" path="/refresh" id="41503d1e-7592-4228-9a78-809b8efda1bf">
  <con:settings>
    <con:setting id="41503d1e-7592-4228-9a78-809b8efda1bffileName">%2Frefresh</con:setting>
  </con:settings>
  <con:parameters/>
  <con:method name="refreshSession" id="be2d8c66-c231-45f7-bb8b-ab4dac066c8f" method="POST">
    <con:description>Accepts a valid, unused refresh token, including when its access token
has expired. Returns new access and refresh tokens for the same session.
Both old tokens become invalid. A refresh token is single-use; a replay
returns INVALID_REFRESH_TOKEN. Revoked sessions return SESSION_REVOKED.
Clients must not blindly retry refresh after an ambiguous network failure.
</con:description>
    <con:settings/>
    <con:parameters/>
    <con:representation type="RESPONSE">
      <con:mediaType>application/json</con:mediaType>
      <con:status>200</con:status>
      <con:params/>
      <con:description>Tokens rotated atomically</con:description>
      <con:sampleContent>{
  "access_token" : "synthetic-access-token-2",
  "refresh_token" : "synthetic-refresh-token-2",
  "token_type" : "Bearer",
  "expires_in" : 300,
  "session_id" : "session-demo-1"
}</con:sampleContent>
    </con:representation>
    <con:representation type="RESPONSE">
      <con:mediaType>application/problem+json</con:mediaType>
      <con:status>400</con:status>
      <con:params/>
      <con:description>Missing or invalid request fields</con:description>
      <con:sampleContent>{
  "type" : "urn:banking:error:invalid-request",
  "title" : "Invalid request",
  "status" : 400,
  "code" : "INVALID_REQUEST",
  "detail" : "A required field is missing or invalid."
}</con:sampleContent>
    </con:representation>
    <con:representation type="RESPONSE">
      <con:mediaType>application/problem+json</con:mediaType>
      <con:status>401</con:status>
      <con:params/>
      <con:description>Invalid refresh token or revoked session</con:description>
      <con:sampleContent>{
  "type" : "string",
  "title" : "string",
  "status" : 0,
  "code" : "INVALID_REQUEST",
  "detail" : "string"
}</con:sampleContent>
    </con:representation>
    <con:representation type="REQUEST">
      <con:mediaType>application/json</con:mediaType>
      <con:params/>
      <con:sampleContent>{
  "refresh_token" : "synthetic-refresh-token-1"
}</con:sampleContent>
    </con:representation>
    <con:request name="Request 1" id="01130b6d-4b5f-408b-8f26-af59b1f1a482" mediaType="application/json">
      <con:settings/>
      <con:endpoint>http://localhost:8081</con:endpoint>
      <con:request>{\r
  "refresh_token" : "synthetic-refresh-token-1"\r
}</con:request>
      <con:credentials>
        <con:selectedAuthProfile>No Authorization</con:selectedAuthProfile>
        <con:authType>No Authorization</con:authType>
      </con:credentials>
      <con:parameters/>
      <con:environmentSpec>
        <con:entry environmentId="68d4a8b0-5218-4ea4-b3cc-99a246e1da53">
          <con:authProfile>Inherit From Parent</con:authProfile>
        </con:entry>
      </con:environmentSpec>
    </con:request>
    <con:environmentSpec>
      <con:entry environmentId="68d4a8b0-5218-4ea4-b3cc-99a246e1da53">
        <con:authProfile>Inherit From Parent</con:authProfile>
      </con:entry>
    </con:environmentSpec>
  </con:method>
  <con:environmentSpec>
    <con:entry environmentId="68d4a8b0-5218-4ea4-b3cc-99a246e1da53">
      <con:authProfile>Inherit From Parent</con:authProfile>
    </con:entry>
  </con:environmentSpec>
</con:resource>
