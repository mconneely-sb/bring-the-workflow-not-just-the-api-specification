  <con:parameters/>
  <con:method name="logoutUser" id="0e27f9f9-a701-4fa0-9f47-dcdb562998c9" method="POST">
    <con:description>The body token must be the current refresh token. A valid refresh token
permits cleanup even if the access token has expired. A first successful
logout returns 204 with no response body. Already revoked sessions return
401 SESSION_REVOKED. Invalid or rotated tokens return INVALID_REFRESH_TOKEN.
</con:description>
    <con:settings/>
    <con:parameters/>
    <con:representation type="RESPONSE">
      <con:status>204</con:status>
      <con:params/>
      <con:description>Session revoked; no response body</con:description>
    </con:representation>
    <con:representation type="RESPONSE">
      <con:mediaType>application/problem+json</con:mediaType>
      <con:status>400</con:status>
      <con:params/>
      <con:description>Missing or invalid request fields</con:description>
      <con:sampleContent>{
  "type" : "urn:banking:error:invalid-request",
  "title" : "Invalid request",
  "status" : 400,
  "code" : "INVALID_REQUEST",
  "detail" : "A required field is missing or invalid."
}</con:sampleContent>
    </con:representation>
    <con:representation type="RESPONSE">
      <con:mediaType>application/problem+json</con:mediaType>
      <con:status>401</con:status>
      <con:params/>
      <con:description>Invalid refresh token or already revoked session</con:description>
      <con:sampleContent>{
  "type" : "string",
  "title" : "string",
  "status" : 0,
  "code" : "INVALID_REQUEST",
  "detail" : "string"
}</con:sampleContent>
    </con:representation>
    <con:representation type="REQUEST">
      <con:mediaType>application/json</con:mediaType>
      <con:params/>
