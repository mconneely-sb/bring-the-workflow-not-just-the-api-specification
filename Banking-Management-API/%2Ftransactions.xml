  <con:parameters/>
  <con:method name="listTransactions" id="78fa5958-9fe6-4459-b8e9-d47d65921507" method="GET">
    <con:description>Inclusive UTC calendar-date boundaries. fromDate must be &lt;= toDate when
both are supplied. Results are sorted by date then ID. The cursor freezes
the snapshot and filters; nextCursor null marks the final page.
Omit unset dates; do not send literal null or empty date strings.
An account without matching transactions returns an empty final page.
</con:description>
    <con:settings/>
    <con:parameters>
      <con:parameter required="true">
        <con:name>accountId</con:name>
        <con:style>QUERY</con:style>
      </con:parameter>
      <con:parameter>
        <con:name>fromDate</con:name>
        <con:style>QUERY</con:style>
      </con:parameter>
      <con:parameter>
        <con:name>toDate</con:name>
        <con:style>QUERY</con:style>
      </con:parameter>
      <con:parameter>
        <con:name>cursor</con:name>
        <con:style>QUERY</con:style>
        <con:description>Omit or send empty for the first page; otherwise use nextCursor</con:description>
      </con:parameter>
      <con:parameter>
        <con:name>limit</con:name>
        <con:value>2</con:value>
        <con:style>QUERY</con:style>
        <con:default>2</con:default>
      </con:parameter>
    </con:parameters>
    <con:representation type="RESPONSE">
      <con:mediaType>application/json</con:mediaType>
      <con:status>200</con:status>
      <con:params/>
      <con:description>One page of transactions</con:description>
      <con:sampleContent>{
  "items" : [ {
    "id" : "txn-demo-1",
    "accountId" : "acc-source",
    "transferId" : "transfer-demo-1",
    "date" : "2026-10-01",
    "amountMinor" : -12500,
    "currency" : "EUR",
    "description" : "Transfer debit"
  } ],
  "nextCursor" : null
}</con:sampleContent>
    </con:representation>
    <con:representation type="RESPONSE">
      <con:mediaType>application/problem+json</con:mediaType>
      <con:status>400</con:status>
      <con:params/>
      <con:description>Invalid fields, cursor, date range, or identical transfer accounts</con:description>
      <con:sampleContent>{
  "type" : "urn:banking:error:invalid-request",
  "title" : "Invalid request",
  "status" : 400,
  "code" : "INVALID_REQUEST",
  "detail" : "Request validation failed."
}</con:sampleContent>
    </con:representation>
    <con:representation type="RESPONSE">
      <con:mediaType>application/problem+json</con:mediaType>
      <con:status>401</con:status>
      <con:params/>
      <con:description>Authentication failed before any side effect. A revoked session takes
precedence over expiry. Only TOKEN_EXPIRED permits refresh recovery.
</con:description>
      <con:sampleContent>{
  "type" : "string",
  "title" : "string",
  "status" : 0,
  "code" : "INVALID_REQUEST",
  "detail" : "string"
}</con:sampleContent>
    </con:representation>
    <con:representation type="RESPONSE">
      <con:mediaType>application/problem+json</con:mediaType>
      <con:status>403</con:status>
      <con:params/>
      <con:description>Resource belongs to another customer</con:description>
      <con:sampleContent>{
  "type" : "urn:banking:error:forbidden",
  "title" : "Forbidden",
  "status" : 403,
  "code" : "FORBIDDEN",
  "detail" : "The customer does not own this resource."
}</con:sampleContent>
    </con:representation>
    <con:representation type="RESPONSE">
      <con:mediaType>application/problem+json</con:mediaType>
      <con:status>404</con:status>
      <con:params/>
      <con:description>Account or transfer does not exist</con:description>
      <con:sampleContent>{
  "type" : "urn:banking:error:not-found",
  "title" : "Not found",
  "status" : 404,
  "code" : "NOT_FOUND",
  "detail" : "The requested resource does not exist."
}</con:sampleContent>
    </con:representation>
